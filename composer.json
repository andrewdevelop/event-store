{
    "name": "andrewdevelop/event-store",
    "description": "A basic event store for Laravel/Lumen 9+",
    "type": "package",
    "require": {
        "andrewdevelop/hex-contracts":"^2.0",
        "andrewdevelop/event-sourcing":"^2.2.3",
        "illuminate/container":"^9.0|^10.0",
        "illuminate/config": "^9.0|^10.0",
        "illuminate/database": "^9.0|^10.0",
        "illuminate/support": "^9.0|^10.0",
        "php": "^8.1|^8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "andrewdevelop",
            "email": "andrewdevelop@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Core\\EventStore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Core\\EventStore\\Tests\\": "tests/"
        }
    }
}
